# AI English Coach 后端配置模板
# 使用方法：复制本文件为 .env，然后填入你的密钥
#   copy .env.example .env

# ===== 应用 =====
APP_NAME=AI English Coach
APP_VERSION=0.1.0
DEBUG=true

# ===== 数据库 =====
# SQLite 默认路径为 backend 目录下的 english_app.db
DATABASE_URL=sqlite+aiosqlite:///./english_app.db

# ===== JWT 认证 =====
# 必填：随机密钥，可用以下命令生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# 留空时后端会自动生成并写入 .env
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=5

# ===== AI 对话（deepseek / openai 二选一） =====
AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ===== 语音转写（local / siliconflow / openai） =====
# local：使用本地 faster-whisper 模型，模型目录默认 backend/models/whisper-base
WHISPER_PROVIDER=local
WHISPER_MODEL=models/whisper-base

# 云端模式（siliconflow / openai）需要以下配置
WHISPER_API_KEY=
WHISPER_BASE_URL=https://api.siliconflow.cn/v1
WHISPER_MODEL_NAME=openai/whisper-large-v3

# ===== CORS =====
CORS_ORIGINS=["*"]
